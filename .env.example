# Copy to ".env" for local work. Every value is PUBLIC (it ends up in the browser bundle). Never put a secret key here.

# Supabase: Project Settings -> API. URL + publishable key only (Row Level Security protects the data).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Backend API (sjks-backend): receipts, e-mail, exports, creating admins. e.g. https://api.saharangosag.com
# Leave empty to hide the features that need it.
VITE_API_URL=

# Public website, for the "View website" links. e.g. https://www.saharangosag.com
VITE_SITE_URL=
